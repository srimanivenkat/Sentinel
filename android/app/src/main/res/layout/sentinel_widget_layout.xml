<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D1424"
    android:padding="12dp">

    <!-- Top Row: Icon + Brand + Live Posture Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_logo"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="Sentinel" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SENTINEL MOBILE"
                android:textColor="#00F0FF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PROTECTED • 98/100"
                android:textColor="#00E676"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_ram"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4.6 GB Free"
            android:textColor="#94A3B8"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Bottom Quick Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:gravity="center">

        <!-- 1-Tap Boost Button -->
        <TextView
            android:id="@+id/widget_btn_boost"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="⚡ SPEED BOOST"
            android:textColor="#000000"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="#00F0FF"
            android:layout_marginEnd="4dp" />

        <!-- Panic SOS Button -->
        <TextView
            android:id="@+id/widget_btn_sos"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="🚨 PANIC SOS"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="#FF3B30"
            android:layout_marginStart="4dp" />
    </LinearLayout>
</LinearLayout>
